{
  "name": "quotidien",
  "version": "0.1.0",
  "private": true,
  "description": "Briefing du matin et alertes « bon moment pour… » envoyés par ntfy",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.mjs --passage matin",
